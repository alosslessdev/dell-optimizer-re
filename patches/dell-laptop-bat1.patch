 static u32 __init battery_get_supported_modes(void)
 {
+	struct calling_interface_token *token;
+	u32 modes = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(battery_modes); i++) {
+		token = dell_smbios_find_token(battery_modes[i].token);
+		/* 0xffff means "token present but not implemented" */
+		if (token && token->location != 0xffff)
+			modes |= BIT(battery_modes[i].charge_type);
+	}
+
+	return modes;
+}
+
+static u32 __init battery_daci_supported_modes(u32 mask)
+{
 	u32 modes = 0;
 	int i;
 
 	for (i = 0; i < ARRAY_SIZE(battery_modes); i++) {
-		if (dell_smbios_find_token(battery_modes[i].token))
+		if (mask & BIT(battery_modes[i].daci_mode - 1))
 			modes |= BIT(battery_modes[i].charge_type);
 	}
 
 	return modes;
 }
 
+static bool __init battery_daci_probe(void)
+{
+	struct dell_battery_daci_info info;
+	u32 modes;
+
+	if (!dell_smbios_class_is_supported(8))
+		return false;
+
+	if (dell_battery_daci_read(&info))
+		return false;
+
+	modes = battery_daci_supported_modes(info.supported);
+	if (!modes)
+		return false;
+
+	battery_supported_modes = modes;
+	return true;
+}
+
 static void __init dell_battery_init(struct device *dev)
 {
 	battery_supported_modes = battery_get_supported_modes();
 
+	if (battery_supported_modes == 0)
+		battery_use_daci = battery_daci_probe();
+
 	if (battery_supported_modes != 0)
 		battery_hook_register(&dell_battery_hook);
 }
