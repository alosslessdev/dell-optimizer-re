+struct dell_battery_daci_info {
+	u8 mode;
+	u8 start;
+	u8 stop;
+	u32 supported;
+};
+
+/*
+ * Some firmware publishes the battery-mode tokens with location 0xffff,
+ * i.e. the token table is present but token I/O is not implemented.  Those
+ * machines still implement the class-8 DACI calls used by Dell Optimizer.
+ */
+static int dell_battery_daci_read(struct dell_battery_daci_info *info)
+{
+	struct calling_interface_buffer buffer;
+	u32 res2, res3;
+	int ret;
+
+	dell_fill_request(&buffer, (1 << 8) | 3, 0x2C, 0, 0);
+	ret = dell_send_request(&buffer, 8, 18);
+	if (ret)
+		return ret;
+
+	res2 = buffer.output[1];
+	res3 = buffer.output[2];
+
+	info->mode = res2 & 0xff;
+	info->start = (res2 >> 8) & 0xff;
+	info->stop = (res2 >> 16) & 0xff;
+	info->supported = res3;
+
+	return 0;
+}
+
+static int dell_battery_daci_write(u8 mode, u8 start, u8 stop)
+{
+	struct calling_interface_buffer buffer;
+	u32 packed = ((u32)stop << 16) | ((u32)start << 8) | mode;
+
+	dell_fill_request(&buffer, (1 << 8) | 0, packed, 0x2C, 0);
+	return dell_send_request(&buffer, 8, 19);
+}
+
+static int dell_battery_type_to_daci_mode(enum power_supply_charge_type type)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(battery_modes); i++)
+		if (battery_modes[i].charge_type == type)
+			return battery_modes[i].daci_mode;
+
+	return -EINVAL;
+}
+
+static enum power_supply_charge_type
+dell_battery_daci_to_type(u8 mode)
+{
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(battery_modes); i++)
+		if (battery_modes[i].daci_mode == mode)
+			return battery_modes[i].charge_type;
+
+	return POWER_SUPPLY_CHARGE_TYPE_UNKNOWN;
+}
